# Copy this file to ".env.sender" next to email_sender_configurator.py and fill in real values.
# This is for email_sender_configurator.py ONLY - it runs on the remote mail server, not on the
# Provision.py app server, and is unrelated to that project's own database/settings.

# Shared secret - must match Settings.mailServerApiSecret configured in Provision.py's /admin_panel/settings/
API_KEY=

# PostfixAdmin MySQL database connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=postfixadmin
DB_USER=postfixadmin
DB_PASSWORD=

# Fixed login/password for the single mailbox created on every domain (both optional, defaults shown)
MAILBOX_LOGIN=order
MAILBOX_PASSWORD=Ezz1NCgtJh4zrN1l

# Optional - where email_sender_configurator.py writes its own log
LOG_FILE=/var/log/email_sender_configurator.log
